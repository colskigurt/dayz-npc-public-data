{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceRunId",
    "buildId",
    "verificationStatus",
    "metrics",
    "blockers",
    "evidenceReferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sourceRunId": {
      "const": "network-gameplay/creature-parent-prearmed1"
    },
    "goalComplete": {
      "const": false
    },
    "verificationStatus": {
      "type": "object",
      "required": [
        "diagnosis",
        "cause",
        "producer",
        "functionalRegression",
        "visualQuality",
        "performance",
        "finalAcceptance"
      ],
      "properties": {
        "finalAcceptance": {
          "const": false
        },
        "performance": {
          "const": "not_measured"
        },
        "cause": {
          "const": "record_format_or_cursor_mismatch_not_yet_localized"
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "parentSamples",
        "badRecordBytes",
        "badRecordBits",
        "badParentReadEndBit",
        "badRecordOverrunBits",
        "badIdsWithinBounds",
        "frameTimeP50P95P99"
      ],
      "properties": {
        "parentSamples": {
          "const": 16
        },
        "badRecordBytes": {
          "const": 16
        },
        "badRecordBits": {
          "const": 128
        },
        "badParentReadEndBit": {
          "const": 146
        },
        "badRecordOverrunBits": {
          "const": 18
        },
        "badIdsWithinBounds": {
          "const": 8
        },
        "frameTimeP50P95P99": {
          "type": "null"
        }
      }
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 2
    }
  }
}