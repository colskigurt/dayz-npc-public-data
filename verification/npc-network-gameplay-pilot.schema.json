{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceRunId",
    "buildId",
    "verificationStatus",
    "metrics",
    "blockers",
    "evidenceReferences"
  ],
  "properties": {
    "sourceRunId": {
      "const": "animation-network-role-20261101-1600/eight-part-20261102/network-gameplay"
    },
    "goalComplete": {
      "const": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "trials",
        "visualAccepted",
        "performanceAccepted"
      ],
      "properties": {
        "trials": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "logicalNpcs",
              "parts",
              "functionalTerminalPredicate",
              "normalQuitVerified"
            ],
            "properties": {
              "logicalNpcs": {
                "const": 1
              },
              "parts": {
                "const": 8
              },
              "normalQuitVerified": {
                "const": false
              }
            }
          }
        },
        "visualAccepted": {
          "const": false
        },
        "performanceAccepted": {
          "const": false
        }
      }
    }
  }
}
