{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceRunId",
    "buildId",
    "verificationStatus",
    "metrics",
    "blockers",
    "evidenceReferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sourceRunId": {
      "const": "network-gameplay/parent-bitcursor-and-writer1"
    },
    "goalComplete": {
      "const": false
    },
    "verificationStatus": {
      "type": "object",
      "required": [
        "diagnosis",
        "packetBounds",
        "producer",
        "functionalRegression",
        "visualQuality",
        "performance",
        "finalAcceptance"
      ],
      "properties": {
        "finalAcceptance": {
          "const": false
        },
        "performance": {
          "const": "not_measured"
        },
        "packetBounds": {
          "const": "not_observed_client_probe_missed_initial_calls"
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "bitSamples",
        "rawBitsMatchSetter",
        "writerSamples",
        "clientDeclaredBoundsSamples",
        "frameTimeP50P95P99"
      ],
      "properties": {
        "bitSamples": {
          "const": 16
        },
        "rawBitsMatchSetter": {
          "const": 16
        },
        "writerSamples": {
          "const": 16
        },
        "clientDeclaredBoundsSamples": {
          "const": 0
        },
        "frameTimeP50P95P99": {
          "type": "null"
        }
      }
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 2
    }
  }
}