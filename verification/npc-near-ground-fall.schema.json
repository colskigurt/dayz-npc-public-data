{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceRunId",
    "buildId",
    "verificationStatus",
    "metrics",
    "blockers",
    "evidenceReferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sourceRunId": {
      "const": "network-gameplay/near-ground-fall-eight-on1"
    },
    "goalComplete": {
      "const": false
    },
    "verificationStatus": {
      "type": "object",
      "required": [
        "functionalRegression",
        "liveRecoveryEfficacy",
        "visualQuality",
        "performance",
        "finalAcceptance"
      ],
      "properties": {
        "functionalRegression": {
          "const": "single_eight_pass"
        },
        "liveRecoveryEfficacy": {
          "const": "not_established"
        },
        "visualQuality": {
          "const": "not_measured"
        },
        "performance": {
          "const": "not_measured"
        },
        "finalAcceptance": {
          "const": false
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "validTerminalAgents",
        "landFollowCycles",
        "totalCandidateUses",
        "frameTimeP50P95P99",
        "defaultOffVerified"
      ],
      "properties": {
        "validTerminalAgents": {
          "const": 8
        },
        "landFollowCycles": {
          "const": 9
        },
        "totalCandidateUses": {
          "const": 0
        },
        "defaultOffVerified": {
          "const": true
        },
        "frameTimeP50P95P99": {
          "type": "null"
        }
      }
    }
  }
}