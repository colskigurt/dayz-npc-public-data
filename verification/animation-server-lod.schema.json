{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceRunId",
    "buildId",
    "verificationStatus",
    "metrics",
    "blockers",
    "evidenceReferences"
  ],
  "properties": {
    "sourceRunId": {
      "const": "animation-server-lod-20261101-1513"
    },
    "goalComplete": {
      "const": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "newRuntimeTrials",
        "newPbo",
        "controlled",
        "probe"
      ],
      "properties": {
        "newRuntimeTrials": {
          "const": 5
        },
        "newPbo": {
          "const": false
        },
        "probe": {
          "type": "object",
          "properties": {
            "evaluationSamples": {
              "const": 60
            },
            "allEvaluationsPrimaryApproximately200ms": {
              "const": true
            }
          }
        }
      }
    }
  }
}