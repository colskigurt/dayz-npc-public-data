{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceRunId",
    "buildId",
    "verificationStatus",
    "metrics",
    "blockers",
    "evidenceReferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sourceRunId": {
      "const": "network-gameplay/slot-support64-matched-control1"
    },
    "goalComplete": {
      "const": false
    },
    "verificationStatus": {
      "type": "object",
      "required": [
        "functionalRegression",
        "visualQuality",
        "performance",
        "finalAcceptance"
      ],
      "properties": {
        "functionalRegression": {
          "const": "both_failed"
        },
        "visualQuality": {
          "const": "not_measured"
        },
        "performance": {
          "const": "no_benefit_demonstrated"
        },
        "finalAcceptance": {
          "const": false
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "independentRuns",
        "conditions",
        "pairs",
        "frameTimeP50P95P99"
      ],
      "properties": {
        "independentRuns": {
          "const": 2
        },
        "conditions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "functionalGatePassed",
              "validTerminalAgents",
              "serverMissionDtMilliseconds"
            ],
            "properties": {
              "functionalGatePassed": {
                "const": false
              },
              "validTerminalAgents": {
                "type": "integer",
                "minimum": 0,
                "maximum": 64
              }
            }
          }
        },
        "frameTimeP50P95P99": {
          "type": "null"
        }
      }
    }
  }
}