{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceRunId",
    "buildId",
    "verificationStatus",
    "metrics",
    "blockers",
    "evidenceReferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string"
    },
    "sourceRunId": {
      "const": "network-gameplay/network-registration-origin1"
    },
    "goalComplete": {
      "const": false
    },
    "verificationStatus": {
      "type": "object",
      "required": [
        "diagnosis",
        "functionalRegression",
        "visualQuality",
        "performance",
        "finalAcceptance"
      ],
      "properties": {
        "finalAcceptance": {
          "const": false
        },
        "performance": {
          "const": "not_measured"
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "initialRegistrationMatches",
        "distinctChildIdentityMeasured",
        "allObservedInputIdsIdentical",
        "clientParts",
        "independentPerformanceRepeats"
      ],
      "properties": {
        "initialRegistrationMatches": {
          "const": 8
        },
        "distinctChildIdentityMeasured": {
          "const": false
        },
        "independentPerformanceRepeats": {
          "const": 0
        }
      }
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 2
    }
  }
}