{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceRunId",
    "buildId",
    "verificationStatus",
    "metrics",
    "blockers",
    "evidenceReferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sourceRunId": {
      "const": "network-gameplay/context-method-and-reader1"
    },
    "goalComplete": {
      "const": false
    },
    "verificationStatus": {
      "type": "object",
      "required": [
        "methodCost",
        "nativeReader",
        "functionalRegression",
        "visualQuality",
        "fullFramePerformance",
        "finalAcceptance"
      ],
      "properties": {
        "finalAcceptance": {
          "const": false
        },
        "fullFramePerformance": {
          "const": "not_measured"
        },
        "visualQuality": {
          "const": "not_measured"
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "totalIndependentProcesses",
        "totalMeasuredSolves",
        "conditions",
        "methodFollowupGatePassed",
        "readerSucceeded",
        "frameTimeP50P95P99"
      ],
      "properties": {
        "totalIndependentProcesses": {
          "const": 2
        },
        "totalMeasuredSolves": {
          "const": 128000
        },
        "readerSucceeded": {
          "const": 3
        },
        "frameTimeP50P95P99": {
          "type": "null"
        }
      }
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 2
    }
  }
}