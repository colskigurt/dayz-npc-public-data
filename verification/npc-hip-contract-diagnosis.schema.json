{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceRunId",
    "buildId",
    "verificationStatus",
    "metrics",
    "blockers",
    "evidenceReferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sourceRunId": {
      "const": "network-gameplay/slot20-hip-contract-comparison1"
    },
    "goalComplete": {
      "const": false
    },
    "verificationStatus": {
      "type": "object",
      "properties": {
        "finalAcceptance": {
          "const": false
        },
        "performance": {
          "const": "not_measured"
        },
        "visualQuality": {
          "const": "not_measured"
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "frozenPoseSamples",
        "results",
        "frameTimeP50P95P99"
      ],
      "properties": {
        "frozenPoseSamples": {
          "const": 12
        },
        "frameTimeP50P95P99": {
          "type": "null"
        },
        "results": {
          "type": "object",
          "required": [
            "pose_core_hip_contract"
          ],
          "properties": {
            "pose_core_hip_contract": {
              "type": "object",
              "required": [
                "landingAndFullPosePass",
                "wallRejections"
              ],
              "properties": {
                "landingAndFullPosePass": {
                  "const": 1
                },
                "wallRejections": {
                  "const": 4
                }
              }
            }
          }
        }
      }
    }
  }
}
