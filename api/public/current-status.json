          "text": "modded class DGBNativeGroundBody {\n    ref array<dBlock> NFInternalBlocks=new array<dBlock>;\noverride void Initialize(int id,DGBNativeGroundDirector director,vector point)\n    {\n        if(!FileExist(\"$profile:nf-network-body.flag\")){super.Initialize(id,director,point);return;}\n        if(!GetGame().IsServer() || !GetGame().IsMultiplayer()){Print(\"NF_NETWORK_BODY_FAILED role\");return;}\n        if(!director.RepartitionModel || !director.Vertical || director.RenderPartCount!=8)\n        {Print(\"DG_SUBSET_INTEGRATION_FAILED unsupported_director\");return;}\n\n        Id=id;Director=director;\n        for(int part=0;part<director.RenderPartCount;part++)\n        {\n            string bodyType=\"NFNetPartsPart\"+part;\n            if(part==0){bodyType=\"DGSubsetIntegratedCrowdLeader\";}\n            int creationFlags=ECE_CREATEPHYSICS;\n            Animal_DGNativeProbe actor=Animal_DGNativeProbe.Cast(GetGame().CreateObjectEx(bodyType,point,creationFlags));"
        },
        {
          "label": "sibling collision block lifetime",
          "fileId": "network-gameplay/source/nf_network_body/Scripts/4_World/NFNetworkBody.c",
          "startLine": 23,
          "endLine": 40,
          "text": "            else if(director.SimulationLod>=0)actor.UpdateSimulationPrecision(director.SimulationLod);\n            actor.SetOrientation(\"180 0 0\");\n            if(dBodyIsSet(actor))\n            {\n                foreach(Animal_DGNativeProbe sibling:Parts)\n                {\n                    if(!dBodyIsSet(sibling)){Print(\"NF_NETWORK_BODY_FAILED sibling_physics\");return;}\n                    dBlock siblingBlock=dBodyCollisionBlock(actor,sibling);\n                    if(!siblingBlock){Print(\"NF_NETWORK_BODY_FAILED sibling_block\");return;}\n                    NFInternalBlocks.Insert(siblingBlock);\n                }\n            }\n            else{Print(\"NF_NETWORK_BODY_FAILED actor_physics\");return;}\n            Parts.Insert(actor);\n            if(part==0)Leader=actor;\n        }\n        if(!Leader)return;\n        if(director.CombatEnabled)"
        },
        {
          "label": "separate damage receiver",
          "fileId": "network-gameplay/source/nf_network_body/Scripts/4_World/NFNetworkBody.c",
          "startLine": 41,
          "endLine": 58,
          "text": "        {\n            DamageReceiver=Animal_DGNativeProbe.Cast(GetGame().CreateObjectEx(\"Animal_DGNativeDamageReceiver\",point,ECE_CREATEPHYSICS));\n            if(!DamageReceiver)return;\n            if(!dBodyIsSet(DamageReceiver)){Print(\"NF_NETWORK_BODY_FAILED receiver_physics\");return;}\n            foreach(Animal_DGNativeProbe renderSibling:Parts)\n            {\n                dBlock receiverBlock=dBodyCollisionBlock(renderSibling,DamageReceiver);\n                if(!receiverBlock){Print(\"NF_NETWORK_BODY_FAILED receiver_block\");return;}\n                NFInternalBlocks.Insert(receiverBlock);\n            }\n            DamageReceiver.GroundBody=this;DamageReceiver.DamageReceiver=true;DamageReceiver.SetAllowDamage(true);\n            DamageReceiver.RuntimeTimingProbe=director.RuntimeTimingProbe;\n            DamageReceiver.SetOrientation(\"180 0 0\");\n            if(director.ResetSimulationPrecision)DamageReceiver.UpdateSimulationPrecision(-1);\n            else if(director.SimulationLod>=0)DamageReceiver.UpdateSimulationPrecision(director.SimulationLod);\n        }\n        Agent.Initialize(Leader);Agent.UseNativeRootDelta=true;\n        if(director.CrowdDynamics){Agent.PeerCoreDistance=0.58;Agent.CollisionPlayers=director.PerceivedPlayers;}"
