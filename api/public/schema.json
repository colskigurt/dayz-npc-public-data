{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DayZ NPC public snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "snapshotId",
    "generatedAt",
    "sourceRunId",
    "buildId",
    "verificationStatus",
    "metrics",
    "blockers",
    "evidenceReferences",
    "freshness",
    "updateState",
    "links",
    "experiments"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "kind": {
      "enum": [
        "status",
        "experiments",
        "metrics"
      ]
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^snapshot-[A-Za-z0-9-]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRunId": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^runtime-[0-9]{8}-[0-9]{6}$"
      }
    },
    "buildId": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9A-Fa-f]{64}$"
      }
    },
    "verificationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnosisSucceeded",
        "experimentSuccess",
        "finalAccepted",
        "functional",
        "visual",
        "performance",
        "regressionChecks"
      ],
      "properties": {
        "diagnosisSucceeded": {
          "type": "boolean"
        },
        "experimentSuccess": {
          "type": "boolean"
        },
        "finalAccepted": {
          "type": "boolean"
        },
        "functional": {
          "type": "string"
        },
        "visual": {
          "type": "string"
        },
        "performance": {
          "type": "string"
        },
        "regressionChecks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metricId",
          "sourceRunId",
          "buildId",
          "value",
          "unit",
          "conditions",
          "repetitions",
          "verificationStatus"
        ],
        "properties": {
          "metricId": {
            "type": "string"
          },
          "sourceRunId": {
            "type": "string"
          },
          "buildId": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{64}$"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "conditions": {
            "type": "object"
          },
          "repetitions": {
            "type": "integer",
            "minimum": 1
          },
          "verificationStatus": {
            "enum": [
              "observed",
              "diagnosis_only",
              "not_accepted"
            ]
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "unmeasured",
              "unexecuted"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "evidenceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "uri",
          "sha256",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "uri": {
            "type": "string",
            "pattern": "^/(data|downloads)/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "const": "curated_public_projection"
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceUpdatedAt",
        "staleAfter",
        "staleAtGeneration",
        "maxAgeSeconds",
        "consumerRule"
      ],
      "properties": {
        "sourceUpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "staleAfter": {
          "type": "string",
          "format": "date-time"
        },
        "staleAtGeneration": {
          "type": "boolean"
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "consumerRule": {
          "type": "string"
        }
      }
    },
    "updateState": {
      "type": "object",
      "required": [
        "lastSuccessfulData",
        "lastAttempt",
        "lastFailure"
      ],
      "properties": {
        "lastSuccessfulData": {
          "type": "object"
        },
        "lastAttempt": {
          "type": "object"
        },
        "lastFailure": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "links": {
      "type": "object",
      "required": [
        "status",
        "experiments",
        "metrics",
        "markdown",
        "schema",
        "immutableBase"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^/"
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
